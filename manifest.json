{
  "manifest_version": 3,
  "name": "IISM form autofill",
  "version": "1.3.0",
  "description": "Autofills the IISM Gulmarg admission form in one click.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://admission.iismgulmarg.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IISM autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://admission.iismgulmarg.in/admission_form.aspx*"
      ],
      "js": [
        "fields.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}